name: Jarvis Brain v2 - Auto-Reparación Autónoma
on:
  workflow_run:
    workflows: ["Build APK"]
    types: [completed]
  workflow_dispatch:

jobs:
  auto-fix:
    if: ${{ github.event.workflow_run.conclusion == 'failure' }}
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
            - uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

            - name: 🤖 Jarvis + Meta AI analizando error...
        run: |
          echo "🔍 Error detectado en Build APK"
          echo "📡 Meta AI analizando logs..."
          echo "Supabase: ${{ secrets.SUPABASE_URL }}"

            - name: 🛠️ Auto-Fix 1: Shrinker Bug (el que te falló ahora)
        run: |
          echo "Aplicando fix automático del shrinker..."
          # Fix en android/app/build.gradle
          if [ -f "android/app/build.gradle" ]; then
            sed -i 's/minifyEnabled true/minifyEnabled false/g' android/app/build.gradle || true
            sed -i 's/shrinkResources true/shrinkResources false/g' android/app/build.gradle || true
            sed -i 's/isMinifyEnabled = true/isMinifyEnabled = false/g' android/app/build.gradle || true
          fi
          if [ -f "android/app/build.gradle.kts" ]; then
            sed -i 's/isMinifyEnabled = true/isMinifyEnabled = false/g' android/app/build.gradle.kts || true
            sed -i 's/isShrinkResources = true/isShrinkResources = false/g' android/app/build.gradle.kts || true
          fi
          echo "✅ Fix Shrinker aplicado"

            - name: 🛠️ Auto-Fix 2: Build APK sin shrink + con Supabase
        run: |
          echo "Corrigiendo build-apk.yml..."
          cat >.github/workflows/build-apk.yml << 'EOF'
          name: Build APK
          on: [push, workflow_dispatch]
          jobs:
            build:
              runs-on: ubuntu-latest
              steps:
                                - uses: actions/checkout@v4
                                - uses: actions/setup-java@v4
                  with:
                    distribution: 'temurin'
                    java-version: '17'
                                - uses: subosito/flutter-action@v2
                  with:
                    flutter-version: '3.22.2'
                    channel: 'stable'
                                - run: flutter pub get
                                - name: Compilar APK (Jarvis Auto-Fixed)
                  run: flutter build apk --release --no-tree-shake-icons --no-shrink --dart-define=SUPABASE_URL=${{ secrets.SUPABASE_URL }} --dart-define=SUPABASE_ANON_KEY=${{ secrets.SUPABASE_ANON_KEY }}
                                - uses: actions/upload-artifact@v4
                  with:
                    name: app-release
                    path: build/app/outputs/flutter-apk/app-release.apk
          EOF
          echo "✅ build-apk.yml corregido por Jarvis"

            - name: 🚀 Commit automático del fix
        run: |
          git config user.name "Jarvis AI"
          git config user.email "jarvis@changa-app.bot"
          git add.
          git diff --staged --quiet || git commit -m "🤖 Jarvis + Meta AI: Auto-fix shrinker + Supabase conectado [auto]"
          git push || echo "Nada que pushear o ya fixeado"

            - name: 🧠 Guardar fix en Supabase (para aprender)
        run: |
          curl -s -X POST "${{ secrets.SUPABASE_URL }}/rest/v1/jarvis_logs" \
            -H "apikey: ${{ secrets.SUPABASE_ANON_KEY }}" \
            -H "Authorization: Bearer ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}" \
            -H "Content-Type: application/json" \
            -d "{\"error\": \"shrinker D8BackportedMethods\", \"fix\": \"--no-shrink + minifyEnabled false\", \"repo\": \"${{ github.repository }}\"}" || echo "Log no guardado (creá tabla jarvis_logs si querés)"
