name: Jarvis Brain v6 - AutoFix Definitivo
on:
  workflow_run:
    workflows: ["Build APK"]
    types: [completed]
  workflow_dispatch:

jobs:
  jarvis-auto-fix:
    runs-on: ubuntu-latest
    if: ${{ github.event.workflow_run.conclusion == 'failure' || github.event_name == 'workflow_dispatch' }}
    permissions:
      contents: write
      actions: write
    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: 🧠 Fix Shrinker Definitivo
        run: |
          echo "🔧 Aplicando fixes..."
          if [ -f "android/app/build.gradle" ]; then
            sed -i 's/minifyEnabled true/minifyEnabled false/g' android/app/build.gradle
            sed -i 's/shrinkResources true/shrinkResources false/g' android/app/build.gradle
          fi
          if [ -f "android/app/build.gradle.kts" ]; then
            sed -i 's/isMinifyEnabled = true/isMinifyEnabled = false/g' android/app/build.gradle.kts
            sed -i 's/isShrinkResources = true/isShrinkResources = false/g' android/app/build.gradle.kts
          fi
          FILE=".github/workflows/build-apk.yml"
          if [ -f "$FILE" ]; then
            sed -i 's/actions\/setup-java@v4/actions\/setup-java@v5/g' $FILE
            if ! grep -q "no-shrink" "$FILE"; then
              sed -i 's/flutter build apk --release/flutter build apk --release --no-shrink --no-tree-shake-icons/g' $FILE
            fi
          fi
          echo "✅ Fixes aplicados"

      - name: 💾 Push
        run: |
          git config user.name "Jarvis V6"
          git config user.email "jarvis@auto.bot"
          git add -A
          git diff --staged --quiet || git commit -m "🤖 Jarvis V6: Fix shrinker --no-shrink"
          git push

      - name: 🔄 Re-Disparar Build
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: gh workflow run "Build APK"
